&AtClient
Procedure OnStart()

	// Параметр запуска: путь к файлу внешней обработки. Пустой параметр означает
	// обычный интерактивный запуск, ничего не открываем.
	If IsBlankString(ПараметрЗапуска) Then
		Return;
	EndIf;

	// Загрузка внешнего кода — серверная операция, а модуль приложения исполняется
	// только на клиенте: серверная функция здесь не скомпилируется. Поэтому
	// открываем форму-прослойку, она создаёт обработку на сервере и открывает её
	// основную форму.
	OpenForm("DataProcessor.TestProcessor.Form.Form");

EndProcedure
